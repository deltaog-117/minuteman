#!/usr/bin/env bash
# Fails when code that handles a browsed path reaches for the local disk directly instead of going
# through the `Vfs` trait, so a backend other than the local disk keeps working with every feature.
#
# Only non-test code is looked at (everything from a `#[cfg(test)]` module down is skipped, as are
# comment lines). A file that is local by nature is listed below with the reason; the gate also
# fails when a listed file no longer touches the disk directly, so the list cannot go stale.
#
# A line that only looks like disk access, such as asking an archive entry whether it is a folder,
# ends with `// vfs-gate: archive entry` to be skipped.
set -euo pipefail
cd "$(dirname "$0")/.."

declare -A allowed=(
  [crates/shared/src/vfs.rs]="the local disk backend itself"
  [plugins/ssh/src/link.rs]="the SFTP backend: its is_dir and metadata calls describe a remote file, never this disk"
  [plugins/ssh/src/master.rs]="makes and sweeps the folders of ssh control sockets and logs in this machine's runtime folder, and reads ssh's log, which are not paths a Vfs serves"
  [plugins/ssh/src/askpass.rs]="removes the socket its helper asks through from this machine's runtime folder, which is not a path a Vfs serves"
  [crates/trash/src/lib.rs]="the desktop trash is a local-disk concept"
  [plugins/archive/src/cache.rs]="keeps the listings of big tar.gz files in the app's own cache folder on this machine"
  [crates/theming/src/config.rs]="the app's own config and appearance files"
  [crates/theming/src/dropin.rs]="the drop-in plugin folders of the app's own config directory"
  [crates/shared/src/devices/topology.rs]="reads this machine's /sys to see how its disks are wired, which are not paths a Vfs serves"
  [crates/shared/src/devices/probe.rs]="reads this machine's /proc and /sys to list its disks, which are not paths a Vfs serves"
  [crates/tui/src/history_file.rs]="keeps the undo history in the app's own state folder on this machine"
  [crates/tui/src/cli.rs]="writes the --cwd-file the shell wrapper reads, and the --chooser-file the portal backend reads"
  [crates/tui/src/main.rs]="resolves the start directory from the command line, before any backend exists"
  [crates/portal_backend/src/session.rs]="the portal backend hands mman a scratch file on this machine and reads the answer back, and looks at this machine's HOME and runtime dir"
  [crates/portal_backend/src/terminal.rs]="looks for a terminal program on this machine's PATH"
  [plugins/hud/src/figures.rs]="reads this machine's /proc"
  [plugins/git/src/status.rs]="finds a repository for the git program, which runs on the local disk"
  [crates/plugin_host/src/sandbox.rs]="resolves a path a sandboxed plugin asked for against the browsed folder, to refuse a symlink or .. that leads out of it before the host's Vfs reads it"
  [crates/plugin_host/src/wasm.rs]="reads a plugin's own .wasm program from this machine's disk, which is not a path a Vfs serves"
  [crates/tui/src/plugin_program.rs]="finds and deletes a bundled plugin's program on this machine's disk, which is not a path a Vfs serves"
  [crates/tui/src/plugin_source.rs]="looks for plugin folders to add, which are programs run on this machine"
  [crates/tui/src/plugin_new.rs]="writes a new plugin's folder into the app's own config directory"
  [crates/tui/src/plugin_add.rs]="copies a plugin folder into the app's own config directory, which are programs run on this machine"
  [crates/tui/src/open.rs]="finds programs to launch on this machine's PATH"
  [crates/tui/src/mime_type.rs]="the shared MIME database, and sniffing a local file to pick a desktop program for it"
  [crates/tui/src/associations.rs]="the desktop's application and MIME-association files"
  [plugins/preview/src/hook.rs]="a preview hook is handed a file on this machine's disk and writes its output to a scratch file here"
  [plugins/inspect/src/rows.rs]="this machine's passwd and group, only consulted for a path the host says is on the local disk"
)

pattern='std::fs\b|\bfs::[a-z_]+|File::(open|create)|OpenOptions|\.(is_dir|is_file|exists|metadata|symlink_metadata|canonicalize|read_dir|read_link)\(\)'

hits_in() {
  # A `#[cfg(test)] mod` ends the scan; any other `#[cfg(test)]` item is test-only code, so it and
  # its first line are skipped.
  awk '
    /^#\[cfg\(test\)\]/ { pending = 1; next }
    pending {
      pending = 0
      if ($0 ~ /^mod /) { exit }
      next
    }
    /^[[:space:]]*\/\// { next }
    /\/\/ vfs-gate: archive entry$/ { next }
    { print FILENAME ":" NR ": " $0 }
  ' "$1" | grep -E "$pattern" || true
}

status=0
while IFS= read -r file; do
  hits=$(hits_in "$file")
  if [[ -n "${allowed[$file]+set}" ]]; then
    if [[ -z "$hits" ]]; then
      echo "vfs-gate: $file no longer touches the disk directly; remove it from the allow-list in scripts/vfs-gate"
      status=1
    fi
  elif [[ -n "$hits" ]]; then
    echo "vfs-gate: direct filesystem access outside the Vfs trait (use Vfs, or Vfs::local_path for what must be local):"
    echo "$hits"
    status=1
  fi
done < <(find crates plugins -path '*/src/*' -name '*.rs' | sort)

exit "$status"
